[Unit]
Description=FlipFlop HQ Private Read API
Documentation=https://github.com/flipflop-ai/flipflop-hq
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flipflop
WorkingDirectory=/opt/flipflop/api
Environment="PORT=8000"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 -m uvicorn private_read_api:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flipflop-api

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/flipflop/api/logs

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
