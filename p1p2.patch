@@ -1,5 +1,64 @@
 export const ROLES = Object.freeze(["ROOT_OWNER","ADMIN","USER","VIEWER"]);
 
+// Every session-protected route names exactly one action. Unknown action or
+// unknown role is denied. No action grants LIVE, broker, CONTROL, routing,
+// or order authority; those have no action name and cannot be added by data.
+export const ACTIONS = Object.freeze([
+  "auth.session",
+  "auth.device.register",
+  "read.product",
+  "read.platform.config",
+  "read.edge.rootDashboard",
+  "ai.ask",
+  "realtime.subscribe",
+  "write.notifications.self",
+  "write.alerts.ack",
+  "write.shadow",
+  "write.shadow.marketMark",
+  "write.preview",
+  "admin.ops",
+  "admin.security",
+]);
+
+const BASE = ["auth.session","auth.device.register","read.product","ai.ask","realtime.subscribe","write.notifications.self"];
+
+// Frozen arrays, not Sets: Object.freeze does not stop Set.prototype.add.
+export const PERMISSIONS = Object.freeze({
+  ROOT_OWNER: Object.freeze([...ACTIONS]),
+  ADMIN: Object.freeze([
+    ...BASE,
+    "read.platform.config",
+    "write.alerts.ack",
+    "write.shadow",
+    "write.shadow.marketMark",
+    "write.preview",
+    "admin.ops",
+  ]),
+  USER: Object.freeze([
+    ...BASE,
+    "write.alerts.ack",
+    "write.shadow",
+    "write.preview",
+  ]),
+  VIEWER: Object.freeze([...BASE]),
+});
+
+export function can(session, action) {
+  if (!session || !ROLES.includes(session.role)) return false;
+  if (!ACTIONS.includes(action)) return false;
+  return PERMISSIONS[session.role].includes(action);
+}
+
+export function rootOnlyAction(action) {
+  return ACTIONS.includes(action) && ROLES.every(r => r === "ROOT_OWNER" || !PERMISSIONS[r].includes(action));
+}
+
+export function permissionMatrix() {
+  const out = {};
+  for (const action of ACTIONS) out[action] = ROLES.filter(r => PERMISSIONS[r].includes(action));
+  return out;
+}
+
 export function canReadAccount(session, accountId) {
   if (!session || !ROLES.includes(session.role)) return false;
   if (session.role === "ROOT_OWNER") return true;
