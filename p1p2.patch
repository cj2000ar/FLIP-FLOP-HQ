diff --git a/work/tests/authz-matrix.test.mjs b/work/tests/authz-matrix.test.mjs
new file mode 100644
index 0000000..dcfdd6c
--- /dev/null
+++ b/work/tests/authz-matrix.test.mjs
@@ -0,0 +1,159 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import {fileURLToPath} from "node:url";
+import {ROLES,ACTIONS,PERMISSIONS,can,rootOnlyAction,permissionMatrix,canMutateLiveAuthority} from "../src/security/authz.mjs";
+import {CoreDb} from "../src/storage/db.mjs";
+import {AuthService} from "../src/services/auth-service.mjs";
+
+const root=path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+const server=fs.readFileSync(path.join(root,"src","server.mjs"),"utf8");
+
+// The approved matrix, written out in full so a drift in authz.mjs fails here.
+const EXPECTED={
+  "auth.session":            ["ROOT_OWNER","ADMIN","USER","VIEWER"],
+  "auth.device.register":    ["ROOT_OWNER","ADMIN","USER","VIEWER"],
+  "read.product":            ["ROOT_OWNER","ADMIN","USER","VIEWER"],
+  "read.platform.config":    ["ROOT_OWNER","ADMIN"],
+  "read.edge.rootDashboard": ["ROOT_OWNER"],
+  "ai.ask":                  ["ROOT_OWNER","ADMIN","USER","VIEWER"],
+  "realtime.subscribe":      ["ROOT_OWNER","ADMIN","USER","VIEWER"],
+  "write.notifications.self":["ROOT_OWNER","ADMIN","USER","VIEWER"],
+  "write.alerts.ack":        ["ROOT_OWNER","ADMIN","USER"],
+  "write.shadow":            ["ROOT_OWNER","ADMIN","USER"],
+  "write.shadow.marketMark": ["ROOT_OWNER","ADMIN"],
+  "write.preview":           ["ROOT_OWNER","ADMIN","USER"],
+  "admin.ops":               ["ROOT_OWNER","ADMIN"],
+  "admin.security":          ["ROOT_OWNER"],
+};
+
+function sessionFor(role){return {sessionId:"s",userId:`u-${role}`,role,accountScopes:role==="ROOT_OWNER"?["*"]:["A1"]};}
+
+test("matrix matches the approved table exactly, for every role and action",()=>{
+  assert.deepEqual(Object.keys(EXPECTED).sort(),[...ACTIONS].sort());
+  assert.deepEqual(permissionMatrix(),EXPECTED);
+  for(const action of ACTIONS){
+    for(const role of ROLES){
+      const expected=EXPECTED[action].includes(role);
+      assert.equal(can(sessionFor(role),action),expected,`${role} ${action}`);
+    }
+  }
+});
+
+test("deny by default: unknown action, unknown role, missing session",()=>{
+  for(const role of ROLES){
+    assert.equal(can(sessionFor(role),"write.orders"),false);
+    assert.equal(can(sessionFor(role),""),false);
+    assert.equal(can(sessionFor(role),undefined),false);
+  }
+  assert.equal(can({role:"SUPERUSER"},"read.product"),false);
+  assert.equal(can(null,"read.product"),false);
+  assert.equal(can({},"read.product"),false);
+});
+
+test("VIEWER is strictly read-only: no product-state writes",()=>{
+  const v=sessionFor("VIEWER");
+  for(const action of ACTIONS.filter(a=>a.startsWith("write.")||a.startsWith("admin.")))
+    if(action!=="write.notifications.self") assert.equal(can(v,action),false,action);
+  assert.equal(can(v,"read.product"),true);
+  assert.equal(can(v,"write.notifications.self"),true);
+});
+
+test("USER has no admin and no market-mark; ADMIN has ops only, never security",()=>{
+  const u=sessionFor("USER"),a=sessionFor("ADMIN");
+  assert.equal(can(u,"admin.ops"),false);
+  assert.equal(can(u,"admin.security"),false);
+  assert.equal(can(u,"write.shadow.marketMark"),false);
+  assert.equal(can(u,"read.platform.config"),false);
+  assert.equal(can(a,"admin.ops"),true);
+  assert.equal(can(a,"admin.security"),false);
+  assert.equal(can(a,"read.edge.rootDashboard"),false);
+});
+
+test("only ROOT_OWNER holds security administration and the root dashboard",()=>{
+  assert.equal(rootOnlyAction("admin.security"),true);
+  assert.equal(rootOnlyAction("read.edge.rootDashboard"),true);
+  assert.equal(rootOnlyAction("admin.ops"),false);
+  assert.equal(rootOnlyAction("nope"),false);
+  for(const action of ACTIONS) assert.equal(can(sessionFor("ROOT_OWNER"),action),true,action);
+});
+
+test("no action can express LIVE, broker, CONTROL, routing, or order authority",()=>{
+  for(const action of ACTIONS)
+    assert.doesNotMatch(action,/live|broker|order|control|passport|rout/i);
+  for(const role of ROLES) assert.equal(canMutateLiveAuthority(sessionFor(role)),false);
+  assert.throws(()=>{ACTIONS.push("write.orders");},TypeError);
+  assert.throws(()=>{PERMISSIONS.VIEWER.push("admin.security");},TypeError);
+  assert.throws(()=>{PERMISSIONS.VIEWER[0]="admin.security";},TypeError);
+  assert.throws(()=>{PERMISSIONS.NEWROLE=[...ACTIONS];},TypeError);
+  assert.equal(can({role:"VIEWER"},"admin.security"),false);
+});
+
+test("permissions hold for real sessions issued by AuthService",()=>{
+  const dir=fs.mkdtempSync(path.join(os.tmpdir(),"ff-authz-"));
+  const db=new CoreDb(path.join(dir,"core.sqlite"));
+  const auth=new AuthService(db,{sessionSecret:"S".repeat(40),sessionTtlSeconds:3600});
+  auth.createRoot({secret:"root-login-secret-123"});
+  const rootS=auth.login({userId:"root-owner",secret:"root-login-secret-123"}).session;
+  for(const role of ["ADMIN","USER","VIEWER"])
+    assert.equal(auth.createUser(rootS,{userId:role.toLowerCase(),displayName:role,role,secret:"family-secret-123"}).ok,true);
+  const live=(id)=>auth.authenticate(auth.login({userId:id,secret:"family-secret-123"}).token).session;
+  assert.equal(can(rootS,"admin.security"),true);
+  assert.equal(can(live("admin"),"admin.ops"),true);
+  assert.equal(can(live("admin"),"admin.security"),false);
+  assert.equal(can(live("user"),"write.shadow"),true);
+  assert.equal(can(live("user"),"write.shadow.marketMark"),false);
+  assert.equal(can(live("viewer"),"write.shadow"),false);
+  assert.equal(can(live("viewer"),"write.alerts.ack"),false);
+  assert.equal(can(live("viewer"),"read.product"),true);
+  db.close();
+});
+
+// Structural: every session-protected route goes through the matrix.
+test("server routes: requireSession is only called inside requireAction",()=>{
+  const routeCalls=server.match(/const session=requireSession\(/g)??[];
+  const helperCalls=server.match(/const s=requireSession\(req,res\);/g)??[];
+  assert.equal(routeCalls.length,0,"no route calls requireSession directly");
+  assert.equal(helperCalls.length,1,"exactly one requireSession call, inside requireAction");
+  assert.match(server,/function requireAction\(req,res,action\)/);
+  assert.match(server,/if\(!can\(s,action\)\)/);
+  assert.match(server,/code:rootOnlyAction\(action\)\?"ROOT_REQUIRED":"ACTION_DENIED"/);
+});
+
+test("server routes: each gated route names a known action",()=>{
+  const used=[...server.matchAll(/requireAction\(req,res,"([^"]+)"\)/g)].map(m=>m[1]);
+  assert.ok(used.length>=60,`expected >=60 gated routes, found ${used.length}`);
+  for(const a of used) assert.ok(ACTIONS.includes(a),`unknown action in server.mjs: ${a}`);
+});
+
+test("server routes: inventory pins route-to-action mapping for the sensitive ones",()=>{
+  const gate=(routeRe,action)=>{
+    const m=server.match(routeRe);
+    assert.ok(m,`route not found: ${routeRe}`);
+    const after=server.slice(m.index,m.index+400);
+    assert.match(after,new RegExp(`requireAction\\(req,res,"${action.replace(/\./g,"\\.")}"\\)`),`${routeRe} -> ${action}`);
+  };
+  gate(/u\.pathname==="\/api\/shadow\/market-mark"/,"write.shadow.marketMark");
+  gate(/u\.pathname==="\/api\/shadow\/intents"/,"write.shadow");
+  gate(/u\.pathname==="\/api\/shadow\/session-flatten"/,"write.shadow");
+  gate(/u\.pathname\.endsWith\("\/ack"\)/,"write.alerts.ack");
+  gate(/u\.pathname==="\/api\/admin\/alerts\/test"/,"admin.ops");
+  gate(/u\.pathname==="\/api\/ninja-readonly\/validate"/,"admin.ops");
+  gate(/u\.pathname==="\/api\/platform\/config"/,"read.platform.config");
+  gate(/u\.pathname==="\/api\/admin\/users"\)\{\s*const session=requireAction/,"admin.security");
+  gate(/u\.pathname==="\/api\/admin\/sessions\/revoke"/,"admin.security");
+  gate(/u\.pathname==="\/api\/admin\/devices\/revoke"/,"admin.security");
+  gate(/u\.pathname==="\/api\/admin\/account-assignments\/remove"/,"admin.security");
+  gate(/u\.pathname==="\/api\/tune-up\/preview"/,"write.preview");
+  gate(/u\.pathname==="\/api\/guardian\/preflight"/,"write.preview");
+  gate(/u\.pathname==="\/api\/devices\/register"/,"auth.device.register");
+  gate(/u\.pathname==="\/api\/realtime\/events"/,"realtime.subscribe");
+  assert.match(server,/function rootOnlySession\(req,res\)\{\s*return requireAction\(req,res,"read\.edge\.rootDashboard"\);/);
+});
+
+test("server: no inline ROOT_OWNER checks remain on routes now covered by the matrix",()=>{
+  const inline=server.match(/if\(session\.role!=="ROOT_OWNER"\)\s*return sendJson/g)??[];
+  assert.equal(inline.length,0,"inline role checks replaced by requireAction");
+});
